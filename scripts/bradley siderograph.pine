//     _potential


getAspectType(_angleDiff, _orb) =>
    // Return a string or an enum of which aspect is in play
    // We'll do a simplified version using standard angles:
    //   - conjunction = 0
    //   - sextile = 60
    //   - square = 90
    //   - trine = 120
    //   - opposition = 180
    // Check whether p1p2 is within ± orb of each exact angle
    // (Note that you might want to wrap angles >180 as 360-angle, etc.)

    conjunctionActive  =  _angleDiff <= (0 + _orb)
    sextileActive      =  (_angleDiff >= (60 - _orb))  and (_angleDiff <= (60 + _orb))
    squareActive       =  (_angleDiff >= (90 - _orb))  and (_angleDiff <= (90 + _orb))
    trineActive        =  (_angleDiff >= (120 - _orb)) and (_angleDiff <= (120 + _orb))
    oppositionActive   =  (_angleDiff >= (180 - _orb)) 

    // Return a textual label for the aspect or "none"
    conjunctionActive  ? "conjunction" :
      sextileActive    ? "sextile" :
      squareActive     ? "square" :
      trineActive      ? "trine" :
      oppositionActive ? "opposition" : "none"



valency(planetPair) =>
    switch planetPair
        // Long Terms 
        // Jupiter Conjunctions
        "Saturn-Jupiter" => -1
        "Uranus-Jupiter" => -1
        "Neptune-Jupiter" => 1
        "Pluto-Jupiter" => -1
        // Saturn Conjunctions
        "Uranus-Saturn" => -1
        "Neptune-Saturn" => -1
        "Pluto-Saturn" => -1
        // Uranus Conjunctions
        "Neptune-Uranus" => -1
        "Pluto-Uranus" => -1
        // Neptune Conjunctions
        "Pluto-Neptune" => -1

        // Mid Terms 
        "Venus-Mercury" => 1
        "Mars-Mercury" => -1
        "Jupiter-Mercury" => 1
        "Saturn-Mercury" => -1
        "Uranus-Mercury" => 1
        "Neptune-Mercury" => 1
        "Pluto-Mercury" => -1
        "Mars-Venus" => -1
        "Jupiter-Venus" => 1
        "Saturn-Venus" => -1
        "Uranus-Venus" => 1
        "Neptune-Venus" => 1
        "Pluto-Venus" => 1
        "Mercury-Sun" => 1
        "Venus-Sun" => 1
        "Mars-Sun" => -1
        "Jupiter-Sun" => 1
        "Saturn-Sun" => -1
        "Uranus-Sun" => 1
        "Neptune-Sun" => -1
        "Pluto-Sun" => -1
        "Jupiter-Mars" => -1
        "Saturn-Mars" => -1
        "Uranus-Mars" => -1
        "Neptune-Mars" => -1
        "Pluto-Mars" => -1


/// MID TERM 
// Recalculated angular relationships with AL.AngToCirc applied
//@BarefootJoey (MPL-2.0)
venumerc = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(1, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(2, geoout, day, dayr, latitude, longitude, tz))))
marsmerc = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(1, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(4, geoout, day, dayr, latitude, longitude, tz))))
jupimerc = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(1, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(5, geoout, day, dayr, latitude, longitude, tz))))
satumerc = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(1, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(6, geoout, day, dayr, latitude, longitude, tz))))
