uransatu = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(7, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(6, geoout, day, dayr, latitude, longitude, tz))))
neptsatu = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(8, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(6, geoout, day, dayr, latitude, longitude, tz))))
plutsatu = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(9, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(6, geoout, day, dayr, latitude, longitude, tz))))

nepturan = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(8, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(7, geoout, day, dayr, latitude, longitude, tz))))
pluturan = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(9, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(7, geoout, day, dayr, latitude, longitude, tz))))

plutnept = math.abs(AL.degtolowest180(AL.AngToCirc(AL.getplanet(9, geoout, day, dayr, latitude, longitude, tz) - AL.getplanet(8, geoout, day, dayr, latitude, longitude, tz))))
//@BarefootJoey (MPL-2.0)

//@BarefootJoey (MPL-2.0)
// Declination Factor  Mar and Venus
Mars_Dec = AL.getplanet(4, 3, day, dayr, latitude, longitude, tz)
Ven_Dec = AL.getplanet(2, 3, day, dayr, latitude, longitude, tz)
mer_Dec = AL.getplanet(1, 3, day, dayr, latitude, longitude, tz)
//@BarefootJoey (MPL-2.0)



mer_Dec_ := (Mars_Dec + mer_Dec) / 2
combo_dec := (Mars_Dec + Ven_Dec) / 2
// combo_dec = mer_Dec * -1



// Reset and repopulate arrays on each bar
array.clear(LongTermAspectValues)
array.clear(LongTermPlanetPairNames)
array.clear(MidTermAspectValues)
array.clear(MidTermPlanetPairNames)


// Mid Terms Data
midTermAspects = array.from(venumerc,marsmerc, jupimerc, satumerc, uranmerc, neptmerc, plutmerc,marsvenu, jupivenu, satuvenu, uranvenu, neptvenu, plutvenu, mercsun, venusun, marssun, jupisun, satusun, uransun, neptsun, plutsun, jupimars, satumars, uranmars, neptmars, plutmars)


midTermNames = array.from("Venus-Mercury", "Mars-Mercury", "Jupiter-Mercury", "Saturn-Mercury", "Uranus-Mercury", "Neptune-Mercury", "Pluto-Mercury", "Mars-Venus", "Jupiter-Venus", "Saturn-Venus", "Uranus-Venus", "Neptune-Venus", "Pluto-Venus", "Mercury-Sun", "Venus-Sun", "Mars-Sun", "Jupiter-Sun", "Saturn-Sun", "Uranus-Sun", "Neptune-Sun", "Pluto-Sun", "Jupiter-Mars", "Saturn-Mars", "Uranus-Mars", "Neptune-Mars", "Pluto-Mars")



for i = 0 to array.size(midTermAspects) - 1
    array.push(MidTermAspectValues, array.get(midTermAspects, i))
    array.push(MidTermPlanetPairNames, array.get(midTermNames, i))


// Long Terms Data
longTermAspects = array.from(satujupi, uranjupi, neptjupi, plutjupi, uransatu, neptsatu, plutsatu, nepturan, pluturan, plutnept)

longTermNames = array.from("Saturn-Jupiter", "Uranus-Jupiter", "Neptune-Jupiter", "Pluto-Jupiter", "Uranus-Saturn", "Neptune-Saturn", "Pluto-Saturn", "Neptune-Uranus", "Pluto-Uranus", "Pluto-Neptune")


for i = 0 to array.size(longTermAspects) - 1
    array.push(LongTermAspectValues, array.get(longTermAspects, i))
    array.push(LongTermPlanetPairNames, array.get(longTermNames, i))


// Calculate summation for the current bar
var int valancy = na 
if array.size(LongTermAspectValues) > 0 and array.size(LongTermPlanetPairNames) > 0
    for i = 0 to array.size(LongTermAspectValues) - 1
        pairAspAng = array.get(LongTermAspectValues, i)
        pair_name = array.get(LongTermPlanetPairNames, i)

        aspect_type = getAspectType(pairAspAng, orb)  // Replace with your function

        if aspect_type == "square"
            valancy := -1
            summation += calculateWeightStepBased(pairAspAng, 90, orb) * valancy
        else if aspect_type == "opposition"
            valancy := -1
            summation += calculateWeightStepBased(pairAspAng, 180, orb) * valancy
        else if aspect_type == "trine"
            valancy := 1
            summation += calculateWeightStepBased(pairAspAng, 120, orb) * valancy
        else if aspect_type == "sextile"
            valancy := 1
            summation += calculateWeightStepBased(pairAspAng, 60, orb) * valancy

        else if aspect_type == "conjunction"
            valancy := valency(pair_name)
            summation += calculateWeightStepBased(pairAspAng, 0, orb) * valancy


var int valancy_mid = na 
if array.size(MidTermAspectValues) > 0 and array.size(MidTermPlanetPairNames) > 0 
    for m = 0 to array.size(MidTermAspectValues) - 1
        pairAspAng_mid = array.get(MidTermAspectValues, m)
        pair_name_mid = array.get(MidTermPlanetPairNames, m)

        aspect_type_mid = getAspectType(pairAspAng_mid, orb)  // Replace with your function

        if aspect_type_mid == "square"
            valancy_mid := -1
            mid_summation += calculateWeightStepBased(pairAspAng_mid, 90, orb) * valancy_mid
        else if aspect_type_mid == "opposition"
            valancy_mid := -1
            mid_summation += calculateWeightStepBased(pairAspAng_mid, 180, orb) * valancy_mid
        else if aspect_type_mid == "trine"
            valancy_mid := 1
            mid_summation += calculateWeightStepBased(pairAspAng_mid, 120, orb) * valancy_mid
        else if aspect_type_mid == "sextile"
            valancy_mid := 1
            mid_summation += calculateWeightStepBased(pairAspAng_mid, 60, orb) * valancy_mid

        else if aspect_type_mid == "conjunction"
            valancy_mid := valency(pair_name_mid)
            mid_summation += calculateWeightStepBased(pairAspAng_mid, 0, orb) * valancy_mid


// Apply a fast-moving average to smooth the summation
// Adjust this value for faster or slower smoothing
smoothed_summation = ta.ema(summation, smoothing)
long_terms = summation + combo_dec


// P = X(L + D) + M 
sideral_potential = multiplier * (smoothed_summation + combo_dec) + mid_summation

plot(show_long ? summation + combo_dec : na, color= long_term_col, style = plot.style_line, linewidth = 2)
plot(show_mid ? mid_summation : na, color = mid_term_col, style = plot.style_line, linewidth = 2)
plot(show_sidereal ? sideral_potential : na, color = sideral_col, style = plot.style_line, linewidth = 2)
plot(show_dec ? combo_dec : na , color = color.new(color.white, 71), style = plot.style_circles)


// Initialize variables for high and low
var float currentYearHigh = na
var float currentYearLow = na


// Initialize line variables
var line highLine = na
var line lowLine = na
var label highLab = na
var label lowLab = na


// Potential Annual High/Low
if show_high_low

    // Get the start of the current year
    startOfYear = timestamp(year(timenow), 1, 1, 0, 0)

    // Track if a bar is within the current year
    isCurrentYear = (time >= startOfYear)

    // Initialize variables
    var int yearStartBar = na  // Bar index at the start of the year

    // Detect the first bar of the year
    if isCurrentYear and na(yearStartBar)
        yearStartBar := bar_index

    // Update the high and low dynamically for the current year
    if isCurrentYear
        currentYearHigh := na(currentYearHigh) ? sideral_potential : math.max(currentYearHigh, sideral_potential)
        currentYearLow := na(currentYearLow) ? sideral_potential : math.min(currentYearLow, sideral_potential)

    // Draw horizontal lines for the current year high and low
    if not na(currentYearHigh) 
        highLine := line.new(x1=yearStartBar, y1=currentYearHigh, x2=bar_index, y2=currentYearHigh, color=color.green, width=1, style=line.style_solid)
        highLab := label.new(yearStartBar, currentYearHigh, text = "Yr High", color = color.new(color.aqua, 100), textcolor = sideral_col, style = label.style_label_right)
        label.delete(highLab[1])
        line.delete(highLine[1])

    if not na(currentYearLow) 
        lowLine := line.new(x1=yearStartBar, y1=currentYearLow, x2=bar_index, y2=currentYearLow, color=color.red, width=1, style=line.style_solid)
        lowLab := label.new(yearStartBar, currentYearLow, text = "Yr Low", color = color.new(color.aqua, 100), textcolor = sideral_col, style = label.style_label_right)
        label.delete(lowLab[1])
        line.delete(lowLine[1])



// Data gathering for gauge 
minFromStart := na(minFromStart) ? sideral_potential : math.round(math.min(minFromStart, sideral_potential), 1)
maxFromStart := na(maxFromStart) ? sideral_potential : math.round(math.max(maxFromStart, sideral_potential), 1)

minFromStartLongterms := na(minFromStartLongterms) ? long_terms : math.round(math.min(minFromStartLongterms, long_terms), 1)
maxFromStartLongterms := na(maxFromStartLongterms) ? long_terms : math.round(math.max(maxFromStartLongterms, long_terms), 1)

minFromStartMidterms := na(minFromStartMidterms) ? mid_summation : math.round(math.min(minFromStartMidterms, mid_summation), 1)
maxFromStartMidterms := na(maxFromStartMidterms) ? mid_summation : math.round(math.max(maxFromStartMidterms, mid_summation), 1)




//@faiyaz7283 (MPL-2.0)
/// Gauge

// Add a label at the last bar
var label long = na 
var label mid = na 
var label Potn = na 
var label dec = na 
var label short = na 

if barstate.islast
    tbs = prnt.tableStyle.new(bgColor=na, frameColor=na, borderColor=na, borderWidth=cellPad)
    printer = prnt.printer(stack=orientation, loc=displayLoc, tableStyle=tbs, gutterStyle=prnt.gutterStyle.new(true, 1, 1))
    prms = gge.gaugeParams.new(num=0, min=0, max=0, size=size, offColor=offColor, upColor=grdUp, downColor=grdDown, neutralColor=grdNeutral, titleColor=titleColor, titleBgColor=titleBgColor, labelColor=labelColor, titleAlign=titleAlign, titleSize=titleSize, keySize=keySize, labelSize=labelSize, horizontal=orientation)

    if show_sidereal
        paramsAT = gge.gaugeParams.copy(prms)
        paramsAT.num := sideral_potential
        paramsAT.min := minFromStart
        paramsAT.max := maxFromStart
        paramsAT.title := 'Sidereal Potential'
        paramsAT.minLabel := str.format(format, minFromStart)
        paramsAT.maxLabel := str.format(format, maxFromStart)
        printer.gauge(paramsAT)
        Potn := label.new(bar_index, sideral_potential, "Potential", style=label.style_label_left, color= color.new(sideral_col, 100), textcolor = sideral_col, tooltip =  tooltip_potential)
        label.delete(Potn[1])

    if show_long
        paramsAT2 = gge.gaugeParams.copy(prms)
        paramsAT2.num := long_terms
        paramsAT2.min := minFromStartLongterms
        paramsAT2.max := maxFromStartLongterms
        paramsAT2.title := 'Long Terms'
        paramsAT2.minLabel := str.format(format, minFromStartLongterms)
        paramsAT2.maxLabel := str.format(format, maxFromStartLongterms)
        printer.gauge(paramsAT2)
        long := label.new( bar_index, long_terms, "Long Terms", style=label.style_label_left, color= color.new(long_term_col, 100), textcolor = long_term_col, tooltip = tooltip_long_terms)
        label.delete(long[1])



    if show_mid
        paramsAT3 = gge.gaugeParams.copy(prms)
        paramsAT3.num := mid_summation
        paramsAT3.min := minFromStartMidterms
        paramsAT3.max := maxFromStartMidterms
        paramsAT3.title := 'Mid Terms'
        paramsAT3.minLabel := str.format(format, minFromStartMidterms)
        paramsAT3.maxLabel := str.format(format, maxFromStartMidterms)
        printer.gauge(paramsAT3)
        mid := label.new(bar_index, mid_summation, "Mid Terms", style=label.style_label_left, color= color.new(mid_term_col, 100), textcolor = mid_term_col, tooltip = tooltip_middle_terms)
        label.delete(mid[1])

//@faiyaz7283 (MPL-2.0)
        





