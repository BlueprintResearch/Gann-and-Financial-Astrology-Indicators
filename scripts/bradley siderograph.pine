// Linear interpolation function
linearInterp(x, x1, x2, y1, y2) =>
    // Handles linear interpolation between (x1, y1) and (x2, y2)
    y1 + (y2 - y1) * ((x - x1) / (x2 - x1))

// Step-based weighting with linear interpolation
calculateWeightStepBased(_p1p2, _aspectAngle, _orb) =>
    distanceToCulmination = math.abs(_p1p2 - _aspectAngle)

    // 1) Outside orb: Weight is 0
    if distanceToCulmination > _orb
        0.0

    // 2) Exact culmination (0°): Weight is 10
    else if distanceToCulmination == 0
        10.0

    // 3) Between 0° and 5°: Interpolate from 10 to 7.5
    else if distanceToCulmination <= 5
        linearInterp(distanceToCulmination, 0, 5, 10, 7.5)

    // 4) Between 5° and 10°: Interpolate from 7.5 to 2.5
    else if distanceToCulmination <= 10
        linearInterp(distanceToCulmination, 5, 10, 7.5, 2.5)

    // 5) Between 10° and orb: Interpolate from 2.5 to 0
    else
        linearInterp(distanceToCulmination, 10, _orb, 2.5, 0)


