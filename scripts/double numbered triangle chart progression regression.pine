rounding = input.int(0, "Increase or Reduce Price rounding", group = group_label, inline = "3", tooltip = tooltip7, minval = 0)
increase = input.float(1.0, "Price per Cell", group = group_label, inline = "4", tooltip = tooltip6)
show_time = input.bool(true, "Show or Hide the Time varible on the chart.", group = group_label, inline = "5")
hide_start_line = input.bool(true, "Show/Hide startline w/ info label", group = group_label, inline = "6")


