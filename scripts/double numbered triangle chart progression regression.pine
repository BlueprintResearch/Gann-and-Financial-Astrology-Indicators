                array.push(center_lines, c)

                lbl3 = label.new(x = last_bar_index + 30, y = array.get(Center, i), text = str.tostring(val), yloc=yloc.price, textalign= text.align_right, size=size.small, textcolor = col2, color = col1)
                lbl4 = label.new(x = start_bar, y = array.get(Center, i), text = time_val_, yloc=yloc.price, textalign= text.align_right, size=size.small, textcolor = col2, color = col1)

                array.push(center_labels, lbl3)
                array.push(center_labels, lbl4)    

                counter += 1

        // reset counter 
        counter := 0

        // Clear time values
        array.clear(Center)            

    else if ShowRightEdge
        RightEdge = calculateRight(price_, increase, levels)

        for i = 0 to array.size(RightEdge) - 1
            str_val = str.tostring(array.get(RightEdge, i))
            time_val = str.tostring(f_triangular_term(i))
            r = line.new(start_bar, array.get(RightEdge, i), last_bar_index + 30, array.get(RightEdge, i), color = col1)
