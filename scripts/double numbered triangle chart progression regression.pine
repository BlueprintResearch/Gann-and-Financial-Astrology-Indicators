            lbl2 = label.new(x = start_bar, y = array.get(leftEdge, i), text = time_val, yloc=yloc.price, textalign=text.align_right, size=size.tiny, textcolor=col2, color=col1)

            array.push(left_labels, lbl1)
            array.push(left_labels, lbl2)

        // Clear time values
        array.clear(leftEdge)

    else if ShowCenter
        Center = calculateCenter(price_, increase, levels)
        var float line_val = na 
