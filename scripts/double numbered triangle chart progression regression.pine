if barstate.islast

    // Delete prior bar's lines and labels
    for l in left_lines
        line.delete(l)
    array.clear(left_lines)

    for lbl in left_labels
        label.delete(lbl)
    array.clear(left_labels)

    for r in right_lines
        line.delete(r)
    array.clear(right_lines)

    for lbl_ in right_labels
        label.delete(lbl_)
    array.clear(right_labels)

    for c in center_lines
        line.delete(c)
    array.clear(center_lines)

    for lbl__ in center_labels
        label.delete(lbl__)
    array.clear(center_labels)

    if ShowLeftEdge
        leftEdge = calculateLeftEdge(price_, increase, levels)

        for i = 0 to array.size(leftEdge) - 1
            str_val = str.tostring(array.get(leftEdge, i))
            time_val = str.tostring(f_quadratic_term(i))

            // Create new line and store reference
            l = line.new(start_bar, array.get(leftEdge, i), last_bar_index + 30, array.get(leftEdge, i), color = col1)
