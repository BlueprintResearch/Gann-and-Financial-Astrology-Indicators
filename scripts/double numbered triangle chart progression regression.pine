                    label.new(bar_index[rightLenH], ph, str.tostring(math.round(ph, rounding)), style=label.style_label_down, color=labelColorH, textcolor=textColorL, size=size.small, force_overlay=true)
                    
        else
            // If user selected "Low", we do not skip any highs
            array.push(pivotHighsArray, math.round(ph, rounding))
            if not hide_pivot_labels
                label.new(bar_index[rightLenH], ph, str.tostring(math.round(ph, rounding)), style=label.style_label_down, color=labelColorH, textcolor=textColorL, size=size.small, force_overlay=true)
                
        

    // For Pivots Low
    if not na(pl)
        if selectHL == "Low"
            // Skip the first low pivot, push the rest
            if firstPivotLSkipped
                array.push(pivotLowsArray, math.round(pl, rounding))
                if not hide_pivot_labels
                    label.new(bar_index[rightLenL], pl, str.tostring(math.round(pl, rounding)), style=label.style_label_up, color=labelColorL, textcolor=textColorL, size=size.small, force_overlay=true)
            else
                firstPivotLSkipped := true
                if not hide_pivot_labels
                    label.new(bar_index[rightLenL], pl, str.tostring(math.round(pl, rounding)), style=label.style_label_up, color=labelColorL, textcolor=textColorL, size=size.small, force_overlay=true)
        else
            // If user selected "High", we do not skip any lows
            array.push(pivotLowsArray, math.round(pl, rounding))
            if not hide_pivot_labels
                label.new(bar_index[rightLenL], pl, str.tostring(math.round(pl, rounding)), style=label.style_label_up, color=labelColorL, textcolor=textColorL, size=size.small, force_overlay=true)







type tableCells 
    int column
    int row


// Calculate table dimensions
tableRows = levels
tableCols = levels * 2 - 1  // Adjust to accommodate the widest row

// Create table
var table tab = table.new(position, tableCols, tableRows, frame_width = frameWidth, border_width = frameWidth)
var int currentColumn = tableCols / 2
var int currentRow = tableRows - 1
var tableCells[] coordinates = array.new<tableCells>()


// Function to create a cell with value and background color, modified to include show_time
f_createCellWithValueAndColor(col, row, value, count, show_time) =>
    // Determine the text content based on the value of show_time
    cellText = show_time ? str.tostring(value) + "\n" + str.tostring(count) : str.tostring(value)
    
    // Create the table cell
    table.cell(tab, col, row, cellText, bgcolor=frameColor, text_color=tableTextColor, text_size=tableTextSize, width = width, height = height)
    
    // Add the cell's coordinates and value to the respective arrays
    pivot = tableCells.new(col, row)
    array.push(coordinates, pivot)
    array.push(values, value)


// Function to set the background color of the left, right edges and center line of the triangle
setEdgesAndCenterBackground(table tab, int levels, color bgcolor) =>
    int tableColss = levels * 2 - 1
    for row = 0 to levels - 1
        int cellsInRow = row + 1
        int startCol = tableColss / 2 - row
        for colOffset = 0 to cellsInRow - 1
            int col = startCol + colOffset * 2
            if colOffset == 0 or colOffset == cellsInRow - 1 or col == tableColss / 2
                table.cell_set_bgcolor(tab, col, levels - 1 - row, bgcolor)
                

// Function to calculate the left edge sequence
calculateLeftEdge(float startPrice, float increment, int levels) =>
    var float[] leftEdge = array.new_float()
    float currentValue = math.round(startPrice, rounding) + increase

    for level = 1 to levels
        // Add the current value to the left edge array
        array.push(leftEdge, currentValue)
        // Increment the current value by the increment multiplied by the level
        currentValue := currentValue + (increment * level)

    leftEdge


// Function to calculate the left edge sequence
calculateRight(float startPrice, float increment, int levels) =>
    var float[] RightEdge = array.new_float()
    float currentValue = math.round(startPrice, rounding) + increase

    for level = 1 to levels
        // Add the current value to the left edge array
        array.push(RightEdge, currentValue)
        // Increment the current value by the increment multiplied by the level
        currentValue := currentValue + (increment * (level + 1))

    RightEdge


calculateCenter(float startPrice, float increment, int levels) =>
    var float[] Center = array.new_float()
    float currentValue = math.round(startPrice, rounding) + increase

    for level = 1 to levels
        // Add the current value to the left edge array
        array.push(Center, currentValue)
        // Increment the current value by the increment multiplied by the level
        currentValue := currentValue + (increment * (level + .5))

    Center


f_quadratic_term(index) =>
    int((index * (index + 1)) / 2 + 1)


f_triangular_term(index) =>
    int(((index + 1) * (index + 2)) / 2)


f_quadratic_term_center(index) =>
    int(2 * index * index + 2 * index + 1)


f_quadratic_term_center_l(index) =>
    int(2 * index * index + 4 * index + 2)


var tri_levels = array.new_float()

// Check and update scaled current price at specific datetime
if (time == dateTime)
    price_ := selectHL == "High" ? high : low 
    
    int count = 1

    float startingValue = math.round(price_, rounding) + increase

    if selectHL == "Low"
        for row = 0 to levels - 1
            int cellsInRow = row + 1  // Number of cells in the current row
            int startCol = currentColumn - row  // Calculate starting column to center the triangle
            for colOffset = 0 to cellsInRow - 1
                int col = startCol + colOffset * 2  // Step by 2 to reduce the width and center the rows
                f_createCellWithValueAndColor(col, currentRow, startingValue, count, show_time)
                startingValue += increase  // Increment the value for the next cell
                count += 1  // Increment cell count
            currentRow -= 1  // Move to the next row up


    if selectHL == "High"
        for row = 0 to levels - 1
            int cellsInRow = row + 1  // Number of cells in the current row
            int startCol = currentColumn - row  // Calculate starting column to center the triangle
            for colOffset = 0 to cellsInRow - 1
                int col = startCol + colOffset * 2  // Step by 2 to reduce the width and center the rows
                f_createCellWithValueAndColor(col, currentRow, startingValue, count, show_time)
                startingValue += increase  // Increment the value for the next cell
                count += 1  // Increment cell count
            currentRow -= 1  // Move to the next row up


    setEdgesAndCenterBackground(tab, levels, angle_col)


// plot(leftEdge.size())


var label left_time_labs = na 
var int bar_ = na 

var line[] left_lines = array.new<line>()  
var label[] left_labels = array.new<label>()  
var line[] right_lines = array.new<line>()  
var label[] right_labels = array.new<label>()
var line[] center_lines = array.new<line>()  
var label[] center_labels = array.new<label>()



var line[] lines_array = array.new<line>()
var label[] label_array = array.new<label>()
var line l5 = na 
var label lab9 = na 



if (time == dateTime)


    if ShowLeftEdge
        leftEdge = calculateLeftEdge(price_, increase, levels)

        for i = 0 to array.size(leftEdge) - 1

            // Table cell coloring logic
            pivot_high_cell = array.indexof(values, array.get(leftEdge, i))
            if pivot_high_cell >= 0
                coord = array.get(coordinates, pivot_high_cell)
                table.cell_set_bgcolor(tab, coord.column, coord.row, col1)
                table.cell_set_text_color(tab, coord.column, coord.row, col2)
        

    else if ShowCenter
        Center = calculateCenter(price_, increase, levels)
        var float line_val = na 
        var string time_val_ = na     
        var int counter = 0

        for i = 0 to array.size(Center) - 1 


            pivot_high_cell = array.indexof(values, array.get(Center, i))
            if pivot_high_cell >= 0
                coord = array.get(coordinates, pivot_high_cell)
                table.cell_set_bgcolor(tab, coord.column, coord.row, col1)
                table.cell_set_text_color(tab, coord.column, coord.row, col2)
         

    else if ShowRightEdge
        RightEdge = calculateRight(price_, increase, levels)

        for i = 0 to array.size(RightEdge) - 1

            pivot_high_cell = array.indexof(values, array.get(RightEdge, i))
            if pivot_high_cell >= 0
                coord = array.get(coordinates, pivot_high_cell)
                table.cell_set_bgcolor(tab, coord.column, coord.row, col1)
