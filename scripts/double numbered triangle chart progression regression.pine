                table.cell_set_text_color(tab, coord.column, coord.row, textColorL)


    if hide_start_line
        l5 := line.new(start_bar, piv_price, last_bar_index + 90, piv_price, color = tableTextColor,  force_overlay = true)
        line.delete(l5[1])
        lab9 := label.new(x=last_bar_index + 90, y=piv_price , text="Start Price:" + str.tostring(piv_price) + " " + " | Increment:" + str.tostring(increase) + " | Round precision: " + str.tostring(rounding), xloc=xloc.bar_index, yloc=yloc.price, textalign= text.align_right, size=size.small, textcolor = color.black, color = tableTextColor,  force_overlay = true)
        label.delete(lab9[1])



var float result = na 
if barstate.isrealtime or barstate.islast

    price = close
    if selectHL == "High" and increase < 0 // fixes the bug plotting on table in regression 
        array.reverse(values)
        array.reverse(coordinates)
    
        // result3 = math.abs(result1, result2)
    price___ = (math.round(price_, rounding)) + increase

    // I'm subtracting the realtime price which is the close price from the 
    result := (close + increase) - price___

    idx = (math.abs(int(result / increase)))

    // I'm adding 1 because the chart starts with 1 against the price. This add 1 to the time portion * the increment and then added to the first cell price of the chart. 
    sum =  (idx * increase) + price___

    index = array.indexof(values, sum)
    if index > 0 and not barstate.isconfirmed
        coord = array.get(coordinates, index)
        table.cell_set_bgcolor(tab, coord.column, coord.row, realtime_close_bgclr)
        table.cell_set_text_color(tab, coord.column, coord.row, textColorL)









