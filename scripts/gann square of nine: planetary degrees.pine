// ═══════════════════════════════════════════════════════════════════
// Future Degree Projections
// ═══════════════════════════════════════════════════════════════════

// State variables for future projection visualization
var array<line> degree_lines = array.new_line()
var array<label> degree_labels = array.new_label()

// Calculate proportional line height
line_height = ta.atr(14) * 2

if show_future_degrees and (barstate.islast or barstate.isrealtime) and array.size(target_degrees) > 0
    // Clean up previous markers (check size before cleanup)
    if array.size(degree_lines) > 0
        for i = 0 to array.size(degree_lines) - 1
            line.delete(array.get(degree_lines, i))
        array.clear(degree_lines)
    if array.size(degree_labels) > 0
        for i = 0 to array.size(degree_labels) - 1
            label.delete(array.get(degree_labels, i))
        array.clear(degree_labels)

    bar_gap_seconds = timeframe.in_seconds(timeframe.period)
    bar_gap = bar_gap_seconds * 1000

    float prev_lon = planet_long

    for i = 1 to look_ahead
        future_time = time + (bar_gap * i)

        // Get future planet position
        future_lon = f_get_planet_longitude(planet_in, geo, future_time)

        // Get future retrograde status (only for planets that can retrograde)
        future_speed = planet_can_retro ? f_get_planet_speed(planet_in, future_time) : 0.0
        future_retrograde = planet_can_retro and future_speed < 0

        // Check EACH target degree for crossing (show ALL occurrences)
        for j = 0 to array.size(target_degrees) - 1
            target_deg = array.get(target_degrees, j)
            if degree_crossed(prev_lon, future_lon, target_deg)
                // Determine if this degree was already crossed historically
                was_crossed = array.includes(crossed_degrees_history, target_deg)

                // Use different styling for already-crossed degrees
                line_col = was_crossed ? crossed_line_color : future_line_color
                label_bg = was_crossed ? crossed_line_color : future_line_color

                // Calculate position
                crossing_time = future_time
                line_top = close + line_height
                line_bottom = close - line_height

                // Only draw if event is truly in the future
                if crossing_time > time
                    // Draw vertical dotted line
                    new_line = line.new(crossing_time, line_bottom, crossing_time, line_top,
                        xloc=xloc.bar_time,
                        color=line_col,
                        width=1,
                        style=line.style_dotted)
                    array.push(degree_lines, new_line)

                    // Top label: planet symbol + degree + retrograde indicator
                    retro_marker = future_retrograde ? "℞" : ""
                    top_label_text = planet_string + retro_marker + "\n" + str.tostring(target_deg) + "°"
                    new_top_label = label.new(crossing_time, line_top, top_label_text,
                        style=label.style_text_outline,
                        color=label_bg,
                        textcolor=TextColor,
                        xloc=xloc.bar_time,
                        size=vTxtSize,
                        text_font_family=font.family_monospace)
                    array.push(degree_labels, new_top_label)

                    // Bottom label: formatted date/time (only if toggle enabled)
                    if show_future_datetime
                        crossing_date = str.format_time(crossing_time, "MMM d, yy\nHH:mm", timezone=tz_input)
                        new_bottom_label = label.new(crossing_time, line_bottom, crossing_date,
                            style=label.style_text_outline,
                            color=label_bg,
                            textcolor=TextColor,
                            xloc=xloc.bar_time,
                            size=vTxtSize,
                            text_font_family=font.family_monospace)
                        array.push(degree_labels, new_bottom_label)

        prev_lon := future_lon

// ═══════════════════════════════════════════════════════════════════
// Alert Conditions
// ═══════════════════════════════════════════════════════════════════

// Static alertcondition for target degree crossing
alertcondition(any_degree_crossed and show_degree_alerts,
    title="Planet Degree Crossing",
    message="Planet has crossed a target degree")



