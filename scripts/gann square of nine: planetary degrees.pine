//@version=6
indicator("Gann Square of Nine: Planetary Degrees", overlay=true, max_labels_count=500, max_bars_back=500, max_lines_count=500)

// ═══════════════════════════════════════════════════════════════════
// Library Imports
// ═══════════════════════════════════════════════════════════════════
import BlueprintResearch/lib_ephemeris/1 as eph

// ═══════════════════════════════════════════════════════════════════════════
// SECTION: BLUEPRINT RESEARCH ORIGINAL CODE
