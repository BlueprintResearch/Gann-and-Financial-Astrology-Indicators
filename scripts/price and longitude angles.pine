// Other lines use planetary colors
plot(p1x1, color=col1_out, title="1x1 Line")
plot(p1x8, color=col1_out, title="1x8 Line")
plot(p1x4, color=col1_out, title="1x4 Line")
plot(p1x3, color=col1_out, title="1x3 Line")
plot(p1x2, color=col1_out, title="1x2 Line")
plot(p2x1, color=col1_out, title="2x1 Line")
plot(p3x1, color=col1_out, title="3x1 Line")
plot(p4x1, color=col1_out, title="4x1 Line")
plot(p8x1, color=col1_out, title="8x1 Line")


// ═══════════════════════════════════════════════════════════════════
// Future Projections
// ═══════════════════════════════════════════════════════════════════

if show_projections and barstate.islast and time >= high_low_bar_time
    // Clean up previous polylines
    polyline.delete(proj_1x1)
    polyline.delete(proj_1x2)
    polyline.delete(proj_2x1)
    polyline.delete(proj_1x3)
    polyline.delete(proj_3x1)
    polyline.delete(proj_1x4)
    polyline.delete(proj_4x1)
    polyline.delete(proj_1x8)
    polyline.delete(proj_8x1)

    // Clean up previous projection labels
    label.delete(proj_label_1x1)
    label.delete(proj_label_1x2)
    label.delete(proj_label_2x1)
    label.delete(proj_label_1x3)
    label.delete(proj_label_3x1)
    label.delete(proj_label_1x4)
    label.delete(proj_label_4x1)
    label.delete(proj_label_1x8)
    label.delete(proj_label_8x1)

    // Calculate bar gap in milliseconds
    bar_gap = timeframe.in_seconds(timeframe.period) * 1000

    // Initialize point arrays for each visible fan line
    array<chart.point> pts_1x1 = array.new<chart.point>()
    array<chart.point> pts_1x2 = array.new<chart.point>()
    array<chart.point> pts_2x1 = array.new<chart.point>()
    array<chart.point> pts_1x3 = array.new<chart.point>()
    array<chart.point> pts_3x1 = array.new<chart.point>()
    array<chart.point> pts_1x4 = array.new<chart.point>()
    array<chart.point> pts_4x1 = array.new<chart.point>()
    array<chart.point> pts_1x8 = array.new<chart.point>()
    array<chart.point> pts_8x1 = array.new<chart.point>()

    // Add current bar as first point (connects to historical plot)
    if show_1x1
        array.push(pts_1x1, chart.point.from_time(time, p1x1))
    if show_1x2
        array.push(pts_1x2, chart.point.from_time(time, p1x2))
    if show_2x1
        array.push(pts_2x1, chart.point.from_time(time, p2x1))
    if show_1x3
        array.push(pts_1x3, chart.point.from_time(time, p1x3))
    if show_3x1
        array.push(pts_3x1, chart.point.from_time(time, p3x1))
    if show_1x4
        array.push(pts_1x4, chart.point.from_time(time, p1x4))
    if show_4x1
        array.push(pts_4x1, chart.point.from_time(time, p4x1))
    if show_1x8
        array.push(pts_1x8, chart.point.from_time(time, p1x8))
    if show_8x1
        array.push(pts_8x1, chart.point.from_time(time, p8x1))

    // Track accumulated changes for projection
    float proj_accum1 = accumulated_change1
    float proj_accum2 = accumulated_change2
    float proj_accum_syn = accumulated_syn
    float proj_prev_long1 = current_long
    float proj_prev_long2 = current_long_2
    float proj_prev_syn = current_syn
    float proj_avg_accum = average_accum

    // Track final values for end labels
    float final_1x1 = p1x1
    float final_1x2 = p1x2
    float final_2x1 = p2x1
    float final_1x3 = p1x3
    float final_3x1 = p3x1
    float final_1x4 = p1x4
    float final_4x1 = p4x1
    float final_1x8 = p1x8
    float final_8x1 = p8x1

    for i = 1 to look_ahead
        future_time = time + (bar_gap * i)

        // Get future planetary longitudes
        future_long1 = f_get_planet_longitude(planet1_in, geo, future_time)
        future_long2 = f_get_planet_longitude(planet2_in, geo, future_time)

        if line_type == "Single"
            // Single mode: Only use Planet 1's longitude
            float delta1 = future_long1 - proj_prev_long1
            if delta1 > 180
                delta1 -= 360
            else if delta1 < -180
                delta1 += 360
            proj_accum1 += delta1
            proj_avg_accum := proj_accum1

        else if line_type == "Average"
            // Calculate longitude deltas with wraparound handling
            float delta1 = future_long1 - proj_prev_long1
            if delta1 > 180
                delta1 -= 360
            else if delta1 < -180
                delta1 += 360
            proj_accum1 += delta1

            float delta2 = future_long2 - proj_prev_long2
            if delta2 > 180
                delta2 -= 360
            else if delta2 < -180
                delta2 += 360
            proj_accum2 += delta2

            proj_avg_accum := math.avg(proj_accum1, proj_accum2)

        else // Synodic
            float future_syn = normalize360(future_long1 - future_long2)
            float syn_delta = future_syn - proj_prev_syn
            if syn_delta < -180
                syn_delta += 360
            else if syn_delta > 180
                syn_delta -= 360
            proj_accum_syn += syn_delta
            proj_avg_accum := proj_accum_syn
            proj_prev_syn := future_syn

        // Calculate projected fan values using same formulas as historical
        float proj_1x1_val = targetPrice1 + (scale_ratio1 * proj_avg_accum) * mirror_out
        float proj_1x2_val = targetPrice1 + (scale_ratio1 / 2) * proj_avg_accum * mirror_out
        float proj_2x1_val = targetPrice1 + (scale_ratio1 * 2) * proj_avg_accum * mirror_out
        float proj_1x3_val = targetPrice1 + (scale_ratio1 / 3) * proj_avg_accum * mirror_out
        float proj_3x1_val = targetPrice1 + (scale_ratio1 * 3) * proj_avg_accum * mirror_out
        float proj_1x4_val = targetPrice1 + (scale_ratio1 / 4) * proj_avg_accum * mirror_out
        float proj_4x1_val = targetPrice1 + (scale_ratio1 * 4) * proj_avg_accum * mirror_out
        float proj_1x8_val = targetPrice1 + (scale_ratio1 / 8) * proj_avg_accum * mirror_out
        float proj_8x1_val = targetPrice1 + (scale_ratio1 * 8) * proj_avg_accum * mirror_out

        // Average with planet 2 diagonal values
        float proj_2_1x1_val = targetPrice2 + (scale_ratio1 * proj_avg_accum) * mirror_out
        float proj_2_1x2_val = targetPrice2 + (scale_ratio1 / 2) * proj_avg_accum * mirror_out
        float proj_2_2x1_val = targetPrice2 + (scale_ratio1 * 2) * proj_avg_accum * mirror_out
        float proj_2_1x3_val = targetPrice2 + (scale_ratio1 / 3) * proj_avg_accum * mirror_out
        float proj_2_3x1_val = targetPrice2 + (scale_ratio1 * 3) * proj_avg_accum * mirror_out
        float proj_2_1x4_val = targetPrice2 + (scale_ratio1 / 4) * proj_avg_accum * mirror_out
        float proj_2_4x1_val = targetPrice2 + (scale_ratio1 * 4) * proj_avg_accum * mirror_out
        float proj_2_1x8_val = targetPrice2 + (scale_ratio1 / 8) * proj_avg_accum * mirror_out
        float proj_2_8x1_val = targetPrice2 + (scale_ratio1 * 8) * proj_avg_accum * mirror_out

        // Final averaged values
        final_1x1 := math.avg(proj_1x1_val, proj_2_1x1_val)
        final_1x2 := math.avg(proj_1x2_val, proj_2_1x2_val)
        final_2x1 := math.avg(proj_2x1_val, proj_2_2x1_val)
        final_1x3 := math.avg(proj_1x3_val, proj_2_1x3_val)
        final_3x1 := math.avg(proj_3x1_val, proj_2_3x1_val)
        final_1x4 := math.avg(proj_1x4_val, proj_2_1x4_val)
        final_4x1 := math.avg(proj_4x1_val, proj_2_4x1_val)
        final_1x8 := math.avg(proj_1x8_val, proj_2_1x8_val)
        final_8x1 := math.avg(proj_8x1_val, proj_2_8x1_val)

        // Add points to arrays
        if show_1x1
            array.push(pts_1x1, chart.point.from_time(future_time, final_1x1))
        if show_1x2
            array.push(pts_1x2, chart.point.from_time(future_time, final_1x2))
        if show_2x1
            array.push(pts_2x1, chart.point.from_time(future_time, final_2x1))
        if show_1x3
            array.push(pts_1x3, chart.point.from_time(future_time, final_1x3))
        if show_3x1
            array.push(pts_3x1, chart.point.from_time(future_time, final_3x1))
        if show_1x4
            array.push(pts_1x4, chart.point.from_time(future_time, final_1x4))
        if show_4x1
            array.push(pts_4x1, chart.point.from_time(future_time, final_4x1))
        if show_1x8
            array.push(pts_1x8, chart.point.from_time(future_time, final_1x8))
        if show_8x1
            array.push(pts_8x1, chart.point.from_time(future_time, final_8x1))

        // Update previous values for next iteration
        proj_prev_long1 := future_long1
        proj_prev_long2 := future_long2

    // Create polylines with dotted style and transparency
    proj_col = color.new(col1_out, proj_transparency)

    if show_1x1 and array.size(pts_1x1) > 1
        proj_1x1 := polyline.new(pts_1x1, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_1x2 and array.size(pts_1x2) > 1
        proj_1x2 := polyline.new(pts_1x2, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_2x1 and array.size(pts_2x1) > 1
        proj_2x1 := polyline.new(pts_2x1, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_1x3 and array.size(pts_1x3) > 1
        proj_1x3 := polyline.new(pts_1x3, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_3x1 and array.size(pts_3x1) > 1
        proj_3x1 := polyline.new(pts_3x1, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_1x4 and array.size(pts_1x4) > 1
        proj_1x4 := polyline.new(pts_1x4, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_4x1 and array.size(pts_4x1) > 1
        proj_4x1 := polyline.new(pts_4x1, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_1x8 and array.size(pts_1x8) > 1
        proj_1x8 := polyline.new(pts_1x8, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)
    if show_8x1 and array.size(pts_8x1) > 1
        proj_8x1 := polyline.new(pts_8x1, xloc=xloc.bar_time, line_color=proj_col, line_style=line.style_solid)

    // Add dual labels at projection end (current bar labels already exist above)
    future_end_time = time + (bar_gap * look_ahead)
    if show_proj_labels
        if show_1x1
            proj_label_1x1 := label.new(x=future_end_time, y=final_1x1, text="1x1", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_1x2
            proj_label_1x2 := label.new(x=future_end_time, y=final_1x2, text="1x2", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_2x1
            proj_label_2x1 := label.new(x=future_end_time, y=final_2x1, text="2x1", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_1x3
            proj_label_1x3 := label.new(x=future_end_time, y=final_1x3, text="1x3", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_3x1
            proj_label_3x1 := label.new(x=future_end_time, y=final_3x1, text="3x1", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_1x4
            proj_label_1x4 := label.new(x=future_end_time, y=final_1x4, text="1x4", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_4x1
            proj_label_4x1 := label.new(x=future_end_time, y=final_4x1, text="4x1", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_1x8
            proj_label_1x8 := label.new(x=future_end_time, y=final_1x8, text="1x8", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)
        if show_8x1
            proj_label_8x1 := label.new(x=future_end_time, y=final_8x1, text="8x1", xloc=xloc.bar_time, color=color.new(color.white, 100), textcolor=proj_col, size=label_text_size, style=label.style_label_up)



/// COLOR WORKS 
var bool color_bar = false 

if (time >= high_low_bar_time) and show_orbital_clr
    color_bar := true


getHue(sign) =>
    var float hue = na
    if sign == "Aries"
        hue := 0
    else if sign == "Taurus"
        hue := 30
    else if sign == "Gemini"
        hue := 60
    else if sign == "Cancer"
        hue := 90
    else if sign == "Leo"
        hue := 120
    else if sign == "Virgo"
        hue := 150
    else if sign == "Libra"
        hue := 180
    else if sign == "Scorpio"
        hue := 210
    else if sign == "Sagittarius"
        hue := 240
    else if sign == "Capricorn"
        hue := 270
    else if sign == "Aquarius"
        hue := 300
    else if sign == "Pisces"
        hue := 330
    hue


getSignFromDegree(deg) =>
    d = deg % 360  // wrap around if deg ≥ 360
    sign = d >= 0   and d < 30  ? "Aries" :
           d >= 30  and d < 60  ? "Taurus" :
           d >= 60  and d < 90  ? "Gemini" :
           d >= 90  and d < 120 ? "Cancer" :
           d >= 120 and d < 150 ? "Leo" :
           d >= 150 and d < 180 ? "Virgo" :
           d >= 180 and d < 210 ? "Libra" :
           d >= 210 and d < 240 ? "Scorpio" :
           d >= 240 and d < 270 ? "Sagittarius" :
           d >= 270 and d < 300 ? "Capricorn" :
           d >= 300 and d < 330 ? "Aquarius" :
           d >= 330 and d < 360 ? "Pisces" :
           na


getColor(sign) =>
    // Base hue from sign name
    baseHue = getHue(sign)

    // Custom hue tweaks
    hue = sign == "Cancer"      ? 80 :  // green-blue
          sign == "Leo"         ? 115 :  // sharp electric lime
          sign == "Virgo"       ? 155 :  // teal-aqua
          sign == "Pisces"      ? 325 :  // shift away from Aries
          sign == "Aries"       ? 0   :  // keep Aries bold red
          baseHue

    // Custom saturation per sign
    sat = sign == "Leo"         ? 1.0  :
          sign == "Pisces"      ? 0.9  :
          sign == "Cancer"      ? 0.85 :
          sign == "Virgo"       ? 0.9  :
          sign == "Aquarius"    ? 0.95 :  // soft magenta
          1.0

    // Custom brightness per sign
    val = sign == "Virgo"       ? 0.8  :
          sign == "Pisces"      ? 0.8  :
          sign == "Cancer"      ? 0.95 :
          1.0

    color.hsv(hue, sat, val, 1)

sign_bar = getSignFromDegree(hue_1x1)


barcolor( color_bar ? getColor(sign_bar): na)

/// COLOR WORKS 




// Zodiac and Longitude Relationship Table 
var table aspectTable = table.new(position.bottom_right, 12, 13, border_width=1)

// === Header Labels ===
headerLabels = array.from("","","","Start &\n☌", "90°\n□", "120°\n△", "180°\n☍", "240°\n△", "270°\n□", "        ", "60°\n✶", "300°\n✶")
zodiacGlyphs = array.from("♈︎", "♉︎", "♊︎", "♋︎", "♌︎", "♍︎", "♎︎", "♏︎", "♐︎", "♑︎", "♒︎", "♓︎")


var row11 = array.from("Pisces", "Gemini", "Cancer", "Virgo", "Scorpio", "Sagittarius", "Taurus", "Capricorn")
var row10 = array.from("Aquarius", "Taurus", "Gemini", "Leo", "Libra", "Scorpio", "Aries", "Sagittarius")
var row9 = array.from("Capricorn", "Aries", "Taurus", "Cancer", "Virgo", "Libra", "Pisces", "Scorpio")
var row8 = array.from("Sagittarius", "Pisces", "Aries", "Gemini", "Leo", "Virgo", "Aquarius", "Libra")
var row7 = array.from("Scorpio", "Aquarius", "Pisces", "Taurus", "Cancer", "Leo", "Capricorn", "Virgo")
var row6 = array.from("Libra", "Capricorn", "Aquarius", "Aries", "Gemini", "Cancer", "Sagittarius", "Leo")
var row5 = array.from("Virgo", "Sagittarius", "Capricorn", "Pisces", "Taurus", "Gemini", "Scorpio", "Cancer")
var row4 = array.from("Leo", "Scorpio", "Sagittarius", "Aquarius", "Aries", "Taurus", "Libra", "Gemini")
var row3 = array.from("Cancer", "Libra", "Scorpio", "Capricorn", "Pisces", "Aries", "Virgo", "Taurus")
var row2 = array.from("Gemini", "Virgo", "Libra", "Sagittarius", "Aquarius", "Pisces", "Leo", "Aries")
var row1 = array.from("Taurus", "Leo", "Virgo", "Scorpio", "Capricorn", "Aquarius", "Cancer", "Pisces")
var row0 = array.from("Aries", "Cancer", "Leo", "Libra", "Sagittarius", "Capricorn", "Gemini", "Aquarius")


if barstate.islast and show_clr_tab
    // Header row
    for col = 0 to 11
        label = array.get(headerLabels, col)
        table.cell(aspectTable, col, 0, label, text_color=tab_text_clr, text_size= label_text_size, text_formatting = text.format_bold)

    // Zodiac rows
    for row = 0 to 11
        currentRow = row == 0  ? row0 :
                     row == 1  ? row1 :
                     row == 2  ? row2 :
                     row == 3  ? row3 :
                     row == 4  ? row4 :
                     row == 5  ? row5 :
                     row == 6  ? row6 :
                     row == 7  ? row7 :
                     row == 8  ? row8 :
                     row == 9  ? row9 :
                     row == 10 ? row10 :
                                 row11

        glyph = array.get(zodiacGlyphs, row)
        deg   = row * 30
        inRange = hue_1x1 >= deg and hue_1x1 < deg + 30
        pointer = inRange ? "▶" : ""
        anchor  = (anchor_hue >= deg and anchor_hue < deg + 30) ? "⚓" : ""

        // Column 0: pointer
        table.cell(aspectTable, 0, row + 1, pointer, text_color= tab_text_clr, text_halign=text.align_center, tooltip = f_degsignf(hue_1x1), text_size = label_text_size)

        // Column 1: anchor
        table.cell(aspectTable, 1, row + 1, anchor, text_halign=text.align_center, tooltip = f_degsignf(anchor_hue), text_size = label_text_size)

        // Column 2: glyph
        table.cell(aspectTable, 2, row + 1, glyph, text_color=#000000, text_size = label_text_size)

        // Columns 2–10: aspects
        for col = 3 to 11
            if col == 3
                trueCol = col < 9 ? col - 3 : col - 4
                sign = array.get(currentRow, trueCol)
                table.cell(aspectTable, col, row + 1, sign, bgcolor=getColor(sign), text_color=#000000, text_formatting = text.format_bold, text_size = label_text_size)
            else if col == 9
                table.cell(aspectTable, col, row + 1, "", bgcolor=color.new(color.gray, 85))
            else
                trueCol = col < 9 ? col - 3 : col - 4
                sign = array.get(currentRow, trueCol)
                table.cell(aspectTable, col, row + 1, sign, bgcolor=getColor(sign), text_color=#000000, text_formatting = text.format_italic, text_size = label_text_size)




// Alert conditions
alertcondition(ta.cross(close, p1x1), title="1x1 Cross", message="Price crossed the 1x1 Line")
alertcondition(ta.cross(close, p1x8), title="1x8 Cross", message="Price crossed the 1x8 Line")
alertcondition(ta.cross(close, p1x4), title="1x4 Cross", message="Price crossed the 1x4 Line")
alertcondition(ta.cross(close, p1x3), title="1x3 Cross", message="Price crossed the 1x3 Line")
alertcondition(ta.cross(close, p1x2), title="1x2 Cross", message="Price crossed the 1x2 Line")
alertcondition(ta.cross(close, p2x1), title="2x1 Cross", message="Price crossed the 2x1 Line")
alertcondition(ta.cross(close, p3x1), title="3x1 Cross", message="Price crossed the 3x1 Line")
alertcondition(ta.cross(close, p4x1), title="4x1 Cross", message="Price crossed the 4x1 Line")
alertcondition(ta.cross(close, p8x1), title="8x1 Cross", message="Price crossed the 8x1 Line")

